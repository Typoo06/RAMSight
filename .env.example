# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080

# PostgreSQL
POSTGRES_DB=memory_triage
POSTGRES_USER=memory_triage
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://memory_triage:change-me@postgres:5432/memory_triage

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RULES_DIR=/rules

# MinIO / S3-compatible storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_EVIDENCE=evidence
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_RAW_OUTPUTS=raw-outputs
MINIO_SECURE=false
EVIDENCE_MAX_UPLOAD_BYTES=21474836480

# Volatility
VOLATILITY_PATH=vol
VOLATILITY_SYMBOL_PATH=/opt/volatility/symbols
VOLATILITY_PLUGIN_TIMEOUT_SECONDS=300
VOLATILITY_YARA_RULES_PATH=
