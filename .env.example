# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080

# PostgreSQL
POSTGRES_DB=memory_triage
POSTGRES_USER=memory_triage
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://memory_triage:change-me@postgres:5432/memory_triage

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RULES_DIR=/rules
REPORT_TEMPLATES_DIR=/reports/templates

# MinIO / S3-compatible storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_EVIDENCE=evidence
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_RAW_OUTPUTS=raw-outputs
MINIO_SECURE=false
# Browser-facing endpoint used only when RAMSight creates presigned direct-upload URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
EVIDENCE_MAX_UPLOAD_BYTES=21474836480
# Small compatibility endpoint cap. The frontend prefers direct multipart uploads for large memory dumps.
EVIDENCE_DIRECT_UPLOAD_MAX_BYTES=268435456
EVIDENCE_MULTIPART_PART_SIZE_BYTES=67108864
EVIDENCE_UPLOAD_TEMP_DIR=/tmp/ramsight-evidence-uploads
EVIDENCE_UPLOAD_CHUNK_SIZE_BYTES=16777216
EVIDENCE_UPLOAD_SESSION_TTL_SECONDS=86400

# Volatility
VOLATILITY_PATH=vol
VOLATILITY_SYMBOL_PATH=/opt/volatility/symbols
# Default timeout for ordinary Volatility plugins. YARA scans can be slower on large memory dumps.
VOLATILITY_PLUGIN_TIMEOUT_SECONDS=300
VOLATILITY_YARA_TIMEOUT_SECONDS=900
VOLATILITY_YARA_RULES_PATH=/rules/yara/compiled/elastic_yara.yar

# Optional DeepSeek LLM mode. Put the real key here only on the backend host.
CHATBOT_MODE=standard
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000

CHATBOT_MODE=llm
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000
