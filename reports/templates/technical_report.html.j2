<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ report_title }}</title>
  <style>
    :root { color: #172026; background: #ffffff; font-family: Arial, sans-serif; }
    body { margin: 32px; font-size: 13px; line-height: 1.45; }
    h1, h2, h3 { color: #13212b; page-break-after: avoid; }
    h1 { margin-bottom: 4px; font-size: 26px; }
    h2 { margin-top: 28px; border-bottom: 1px solid #ccd5dc; padding-bottom: 4px; font-size: 18px; }
    h3 { margin-top: 18px; font-size: 14px; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0 18px; table-layout: fixed; }
    th, td { border: 1px solid #d8e0e6; padding: 6px 8px; vertical-align: top; word-break: break-word; }
    th { background: #eef3f6; text-align: left; }
    ul { margin-top: 4px; padding-left: 18px; }
    .muted { color: #5d6b75; }
    .note { border-left: 3px solid #8aa1af; background: #f4f7f9; padding: 8px 10px; margin: 10px 0 16px; }
    .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .metric { border: 1px solid #d8e0e6; padding: 8px; }
    .metric strong { display: block; font-size: 18px; }
    .severity-critical { color: #8a1f11; font-weight: bold; }
    .severity-high { color: #a14a00; font-weight: bold; }
    .severity-medium { color: #6f5b00; font-weight: bold; }
    .severity-low { color: #3f6f4a; font-weight: bold; }
    .nowrap { white-space: nowrap; }
    .compact td, .compact th { padding: 5px 6px; }
    @media print { body { margin: 18mm; } a { color: inherit; text-decoration: none; } }
  </style>
</head>
<body>
  <h1>{{ report_title }}</h1>
  <p class="muted">Report type: {{ report_type }} | Generated at: {{ generated_at }}</p>

  <h2>Executive Summary</h2>
  <div class="note">{{ executive_summary.analyst_note }}</div>
  <div class="summary">
    <div class="metric"><strong>{{ executive_summary.job_status }}</strong>Job status</div>
    <div class="metric"><strong>{{ executive_summary.plugin_status }}</strong>Plugin status</div>
    <div class="metric"><strong>{{ executive_summary.finding_count }}</strong>Total triage findings</div>
    <div class="metric"><strong>{{ executive_summary.high_critical_count }}</strong>High/Critical findings</div>
    <div class="metric"><strong>{{ executive_summary.ioc_count }}</strong>IOC records</div>
    <div class="metric"><strong>{{ executive_summary.memory_region_summary }}</strong>Memory-region signals</div>
  </div>
  <table>
    <tr><th>Evidence</th><td>{{ executive_summary.evidence_filename }}</td><th>OS / profile</th><td>{{ executive_summary.os_profile }}</td></tr>
    <tr><th>YARA status</th><td colspan="3">{{ executive_summary.yara_status }}</td></tr>
  </table>

  <h2>Case Information</h2>
  <table>
    <tr><th>Case code</th><td>{{ case.case_code }}</td><th>Name</th><td>{{ case.name }}</td></tr>
    <tr><th>Status</th><td>{{ case.status }}</td><th>Description</th><td>{{ case.description or "Not provided" }}</td></tr>
  </table>

  <h2>Evidence Metadata</h2>
  <table>
    <tr><th>Filename</th><td>{{ evidence.original_filename }}</td><th>Source type</th><td>{{ evidence.source_type }}</td></tr>
    <tr><th>Size bytes</th><td>{{ evidence.size_bytes or "Unknown" }}</td><th>Acquisition tool</th><td>{{ evidence.acquisition_tool or "Unknown" }}</td></tr>
    <tr><th>MD5</th><td>{{ evidence.md5 or "Unavailable" }}</td><th>SHA256</th><td>{{ evidence.sha256 or "Unavailable" }}</td></tr>
    <tr><th>OS family</th><td>{{ evidence.os_family }}</td><th>OS version</th><td>{{ evidence.os_version or analysis_job.os_version or "Unknown" }}</td></tr>
    <tr><th>Architecture</th><td>{{ evidence.architecture or analysis_job.architecture or "Unknown" }}</td><th>Kernel version</th><td>{{ evidence.kernel_version or analysis_job.kernel_version or "Unknown" }}</td></tr>
    <tr><th>Symbol table</th><td colspan="3">{{ evidence.symbol_table or analysis_job.symbol_table or "Unknown" }}</td></tr>
  </table>

  <h2>Analysis Job</h2>
  <table>
    <tr><th>Job ID</th><td>{{ analysis_job.id }}</td><th>Status</th><td>{{ analysis_job.status }}</td></tr>
    <tr><th>Plugin profile</th><td>{{ analysis_job.plugin_profile or "Default" }}</td><th>Duration ms</th><td>{{ analysis_job.duration_ms or "Unknown" }}</td></tr>
    <tr><th>Started</th><td>{{ analysis_job.started_at or "Unknown" }}</td><th>Completed</th><td>{{ analysis_job.completed_at or "Unknown" }}</td></tr>
  </table>

  <h2>Analysis Summary</h2>
  <div class="summary">
    <div class="metric"><strong>{{ summary.total_plugin_results }}</strong>Total plugin results</div>
    <div class="metric"><strong>{{ summary.completed_plugins }}</strong>Completed plugins</div>
    <div class="metric"><strong>{{ summary.failed_plugins }}</strong>Failed plugins</div>
    <div class="metric"><strong>{{ summary.total_parsed_artifacts }}</strong>Parsed artifacts</div>
    <div class="metric"><strong>{{ summary.total_risk_findings }}</strong>Risk findings</div>
    <div class="metric"><strong>{{ summary.total_ioc_records }}</strong>IOC records</div>
  </div>

  <h2>Plugin Results</h2>
  {% if plugin_status_rows %}
  <table class="compact">
    <tr><th>Plugin</th><th>Status</th><th>Parsed records</th><th>Duration ms</th><th>Timeout</th><th>Error summary</th></tr>
    {% for plugin in plugin_status_rows %}
    <tr>
      <td>{{ plugin.plugin_name }}{% if plugin.is_yara_plugin %}<br><span class="muted">YARA plugin</span>{% endif %}</td>
      <td>{{ plugin.status }}</td>
      <td>{{ plugin.parsed_record_count }}</td>
      <td>{{ plugin.duration_ms }}</td>
      <td>{{ plugin.timeout_status }}</td>
      <td>{{ plugin.error_summary }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}<p>No plugin result metadata was available.</p>{% endif %}

  <h2>Top Suspicious Findings</h2>
  <p class="muted">This section is deduplicated for report readability. Stored findings are not modified.</p>
  {% if display_top_findings %}
  <table>
    <tr><th>Rule</th><th>Severity</th><th>Score</th><th>Process context</th><th>Artifact</th><th>Source plugin</th><th>Recommendation</th></tr>
    {% for finding in display_top_findings %}
    <tr>
      <td>{{ finding.rule }}</td>
      <td class="severity-{{ finding.severity }}">{{ finding.severity }}</td>
      <td>{{ finding.score }}</td>
      <td>
        {% if finding.context_parts %}
        <ul>{% for part in finding.context_parts %}<li>{{ part }}</li>{% endfor %}</ul>
        {% else %}N/A{% endif %}
      </td>
      <td>{{ finding.artifact_type }}</td>
      <td>{{ finding.source_plugin }}</td>
      <td>{{ finding.recommendation }}</td>
    </tr>
    {% endfor %}
  </table>
  {% if top_findings_omitted_count %}<p class="muted">{{ top_findings_omitted_count }} additional similar or lower-priority findings were omitted from this display section.</p>{% endif %}
  {% else %}<p>No risk findings were recorded.</p>{% endif %}

  <h2>Suspicious Process Summary</h2>
  {% if process_finding_groups %}
  <table>
    <tr><th>Process</th><th>Severity</th><th>Score</th><th>Evidence groups</th><th>Counts</th><th>Component rules</th><th>Recommendation</th></tr>
    {% for process in process_finding_groups %}
    <tr>
      <td>{{ process.identity }}</td>
      <td class="severity-{{ process.severity }}">{{ process.severity }}</td>
      <td>{{ process.score }}</td>
      <td>{% if process.evidence_groups %}<ul>{% for group in process.evidence_groups %}<li>{{ group }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}</td>
      <td>
        <ul>
          <li>Memory regions: {{ process.memory_region_count }}</li>
          <li>Network endpoints: {{ process.network_endpoint_count }}</li>
          <li>YARA rules: {{ process.yara_rule_count }}</li>
          <li>YARA raw matches: {{ process.yara_raw_match_count }}</li>
        </ul>
      </td>
      <td>{% if process.component_rule_ids %}<ul>{% for rule in process.component_rule_ids %}<li>{{ rule }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}</td>
      <td>{{ process.recommendation }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}<p>No process-centered risk summaries were available.</p>{% endif %}

  <h2>Memory-only Evidence Chains</h2>
  <p class="muted">Chains group triage evidence by process. They support review; they are not conclusions of compromise.</p>
  {% if memory_evidence_chains %}
    {% for chain in memory_evidence_chains %}
    <h3>{{ chain.identity }}</h3>
    <table>
      <tr><th>Severity</th><td class="severity-{{ chain.severity }}">{{ chain.severity }}</td><th>Score</th><td>{{ chain.score }}</td></tr>
      <tr><th>Evidence groups</th><td colspan="3">{% if chain.evidence_groups %}{% for group in chain.evidence_groups %}{{ group }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}</td></tr>
      <tr><th>Analyst interpretation</th><td colspan="3">{{ chain.interpretation }}</td></tr>
    </table>
    <table class="compact">
      <tr><th>Memory evidence</th><th>YARA evidence</th><th>Network evidence</th><th>IOC references</th></tr>
      <tr>
        <td>
          {% if chain.memory_regions %}<ul>{% for region in chain.memory_regions %}<li>{{ region.address_range }} | {{ region.protection }} | {{ region.source_plugin }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}
          {% if chain.memory_region_count > 3 %}<span class="muted">Additional memory regions omitted from this compact chain.</span>{% endif %}
        </td>
        <td>{% if chain.yara_rules %}<ul>{% for rule in chain.yara_rules %}<li>{{ rule }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}{% if chain.yara_raw_match_count %}<span class="muted">Raw matches: {{ chain.yara_raw_match_count }}</span>{% endif %}</td>
        <td>{% if chain.network_endpoints %}<ul>{% for endpoint in chain.network_endpoints %}<li>{{ endpoint }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}</td>
        <td>{% if chain.ioc_references %}<ul>{% for item in chain.ioc_references %}<li>{{ item.ioc_type }}: {{ item.count }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}</td>
      </tr>
    </table>
    {% endfor %}
  {% else %}<p>No process-centered memory-only evidence chains were available.</p>{% endif %}

  <h2>Network Indicators</h2>
  {% if network_indicators %}
  <table>
    <tr><th>Protocol</th><th>Local</th><th>Remote</th><th>State</th><th>PID</th><th>Process</th></tr>
    {% for item in network_indicators %}
    <tr><td>{{ item.protocol or "" }}</td><td>{{ item.local_address }}:{{ item.local_port }}</td><td>{{ item.remote_address }}:{{ item.remote_port }}</td><td>{{ item.state or "" }}</td><td>{{ item.pid or "" }}</td><td>{{ item.process_name or "" }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p>No network artifacts are available for this report section.</p>{% endif %}

  <h2>Suspicious Module Paths</h2>
  {% if module_artifacts %}
  <table>
    <tr><th>Process</th><th>PID</th><th>Module</th><th>Path</th><th>Source plugin</th></tr>
    {% for module in module_artifacts %}
    <tr><td>{{ module.process_name or "" }}</td><td>{{ module.pid or "" }}</td><td>{{ module.module_name or "" }}</td><td>{{ module.module_path or "" }}</td><td>{{ module.source_plugin or "" }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p>No suspicious module path artifacts were selected.</p>{% endif %}

  <h2>Memory Region Findings</h2>
  {% if memory_regions %}
  <table>
    <tr><th>Process</th><th>PID</th><th>Range</th><th>Protection</th><th>Executable</th><th>Source plugin</th></tr>
    {% for region in memory_regions %}
    <tr><td>{{ region.process_name or "" }}</td><td>{{ region.pid or "" }}</td><td>{{ region.start_address }} - {{ region.end_address }}</td><td>{{ region.protection or "" }}</td><td>{{ region.is_executable }}</td><td>{{ region.source_plugin or "" }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p>No suspicious memory region artifacts were recorded.</p>{% endif %}

  <h2>YARA Matches</h2>
  {% if yara_status and yara_status.message %}<p>{{ yara_status.message }}</p>{% endif %}
  <p class="muted">Demo YARA rules are triage aids and should not be treated as production malware signatures.</p>
  {% if yara_summary %}
  <table>
    <tr><th>Rule</th><th>Match count</th><th>Representative targets</th><th>Sample offsets</th><th>Source plugins</th></tr>
    {% for row in yara_summary %}
    <tr>
      <td>{{ row.rule_name }}</td>
      <td>{{ row.match_count }}</td>
      <td>{% if row.targets %}{% for target in row.targets %}{{ target }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}</td>
      <td>{% if row.sample_offsets %}{% for offset in row.sample_offsets %}{{ offset }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}</td>
      <td>{% if row.source_plugins %}{% for plugin in row.source_plugins %}{{ plugin }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  {% elif not yara_status or not yara_status.message %}<p>No YARA match artifacts were recorded.</p>{% endif %}

  <h2>IOC Summary</h2>
  <p class="muted">{{ ioc_export_note }}</p>
  {% if ioc_summary %}
  <table>
    <tr><th>IOC type</th><th>Count</th><th>Representative values</th><th>Source plugins</th><th>Confidence range</th></tr>
    {% for row in ioc_summary %}
    <tr>
      <td>{{ row.ioc_type }}</td>
      <td>{{ row.count }}</td>
      <td>{% if row.representative_values %}<ul>{% for value in row.representative_values %}<li>{{ value }}</li>{% endfor %}</ul>{% else %}N/A{% endif %}</td>
      <td>{% if row.source_plugins %}{% for plugin in row.source_plugins %}{{ plugin }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}N/A{% endif %}</td>
      <td>{{ row.confidence_range }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}<p>No IOC records were extracted.</p>{% endif %}

  <h2>Raw and Parsed Output References</h2>
  <table>
    <tr><th>Plugin</th><th>Status</th><th>Raw bucket</th><th>Raw key</th><th>Parsed bucket</th><th>Parsed key</th></tr>
    {% for plugin in plugin_status_rows %}
    <tr><td>{{ plugin.plugin_name }}</td><td>{{ plugin.status }}</td><td>{{ plugin.raw_output_bucket }}</td><td>{{ plugin.raw_output_key }}</td><td>{{ plugin.parsed_output_bucket }}</td><td>{{ plugin.parsed_output_key }}</td></tr>
    {% endfor %}
  </table>

  <h2>Incident Response Recommendations</h2>
  <ul>
    {% for recommendation in recommendations %}<li>{{ recommendation }}</li>{% endfor %}
  </ul>

  <h2>Analyst Notes</h2>
  {% if analyst_notes %}
  {% for note in analyst_notes %}<p>{{ note.body }}</p>{% endfor %}
  {% else %}<p class="muted">No analyst notes were recorded at report generation time.</p>{% endif %}
</body>
</html>
