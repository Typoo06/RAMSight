    strings:
		$fnv64a_offset = { 25 23 22 84 e4 9c f2 cb }
		$fnv64a_prime = { B3 01 00 00 00 01 }
    condition:
		// MZ or ELF
		( uint16(0) == 0x5a4d or uint32be(0) == 0x7f454c46 ) and all of them
}
*/

/* END rules/yara/third_party/neo23x0_signature_base/yara/apt_backdoor_sunburst_fnv1a_experimental.yar */

